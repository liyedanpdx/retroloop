MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=retroloop
OPENAI_BASE_URL=http://localhost:8080/v1
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-5.4
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
# The refresh cookie. COOKIE_SECURE must be true wherever the app is served
# over HTTPS; it is false here because a Secure cookie is dropped over http.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# The one browser origin allowed to send credentialed requests. Never *.
FRONTEND_ORIGIN=http://localhost:3000
