# Copy to .env and fill in. .env is untracked at every depth (see .gitignore)
# and must never be committed. Every value below is a placeholder — none of them
# work, on purpose.

# --- Database ---------------------------------------------------------------
# MongoDB is external: this stack does not run one, and `docker compose down`
# never touches it. Use an Atlas SRV URL, or host.docker.internal for a Mongo
# running on your own machine — never localhost, which inside a container means
# the container. Atlas also needs your IP allowed under Network Access.
MONGO_URL=mongodb://host.docker.internal:27017
MONGO_DB_NAME=retroloop

# --- AI proxy (#10, #19) -----------------------------------------------------
# The OpenAI-compatible proxy. With a placeholder key the app runs and every
# non-AI flow works; transcript extraction and cluster suggestions do not.
OPENAI_BASE_URL=http://host.docker.internal:8080/v1
OPENAI_API_KEY=replace-with-your-proxy-key
OPENAI_MODEL=gpt-5.4

# --- Tokens ------------------------------------------------------------------
# Two different long random strings. `python -c "import secrets;
# print(secrets.token_urlsafe(48))"` twice will do it.
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# --- Cookies and CORS (#30) --------------------------------------------------
# COOKIE_SECURE must be true wherever the app is served over HTTPS; it is false
# here because a browser drops a Secure cookie over plain http.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# The one browser origin allowed to send credentialed requests. Never *.
FRONTEND_ORIGIN=http://localhost:3000

# --- Host ports (optional, non-secret) ---------------------------------------
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
